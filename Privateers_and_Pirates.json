      {
        "name": "Jean Lafitte",
        "id": "6dd0-8c88-c7ed-4a6f",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "2917-9ccd-bfca-09b0", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 16}],
        "rules": [
          {
            "name": "Jean Lafitte",
            "id": "c4f1-cf1b-1237-e26d",
            "description": "Scallywag: Your ships may re-roll 2s when rolling their Boarding dice (note that when combined with a Swashbuckler captain, this makes for a fearsome boarding crew!).\nExpert Raider: Whenever one of the ships in your flagship's squadron collides with an enemy ship, the enemy ship may not try to avoid the collision.",
            "hidden": false
          }
        ]
