        "rules": [
          {
            "name": "Bomb Vessel",
            "id": "14b8-d9d1-5afa-1246",
            "description": "Bomb vessels can only fire once per phase, and only while they have an Anchor token, but has a 360° arc of fire and may target any ship in range. These vessels cannot fire at short range, due to the high trajectory of their weapons - they may only choose targets at medium or long range. Furthermore, they always fire as if they have a raking shot, regardless of their position relative to their target.",
            "hidden": false
          }
