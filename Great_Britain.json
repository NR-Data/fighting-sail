      {
        "name": "Disciplinarian",
        "id": "601f-ab00-ed1d-4a43",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "705d-0467-aff4-5173", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 7}],
        "rules": [
          {
            "name": "Disciplinarian",
            "id": "1c82-55f6-30ea-c52c",
            "description": "This admiral uses strict discipline to maintain an orderly fleet. The sailors may love him or hate him, but his rigid philosophy gets results. Once per battle, after one of your ships fails a Discipline test, you may change the result of that test to a success.",
            "hidden": false
          }
        ]
      },
      {
        "name": "Gunner",
        "id": "62fc-7d30-23d0-42d1",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "4873-c604-7e54-fca9", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 10}],
        "rules": [
          {
            "name": "Gunner",
            "id": "f8c1-1f9c-2441-dc04",
            "description": "This admiral constantly trains his men to fire faster and with more accuracy. Once per battle, after one of your ships fires a broadsides, remove its Cannon token. The ship may fire again that turn.",
            "hidden": false
          }
        ]
      },
      {
        "name": "Hero",
        "id": "9625-11c7-4299-85a4",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "1b6a-5757-f87e-de70", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 6}],
        "rules": [
          {
            "name": "Hero",
            "id": "ac97-86d5-37f3-3085",
            "description": "Well known amongst captains and sailors alike, the Hero leads by example. His men often fear his disappointment more than they fear the cannons of their enemies. Your fleet gets a +10% fleet morale bonus.",
            "hidden": false
          }
        ]
