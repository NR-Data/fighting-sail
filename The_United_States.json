      {
        "name": "Daring",
        "id": "0d6b-e1b9-8685-9da1",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "85cb-169e-572b-a09f", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 4}],
        "rules": [
          {
            "name": "Daring",
            "id": "d42b-53f2-9a1e-3dda",
            "description": "The American captains didn't have huge ships, so they had to rely on bravado and skill to help them best their foes. When the initiative roll is tied, your fleet gets the initiative. If both admirals have this ability, then determine who gets initiative as per the normal rules.",
            "hidden": false
          }
        ]
      },
      {
        "name": "Hero",
        "id": "0d07-760d-b0c0-4feb",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "663e-0989-4141-dcca", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 6}],
        "rules": [
          {
            "name": "Hero",
            "id": "4c76-9a11-9959-c3c2",
            "description": "This admiral inspires his crews to fight for their fledging country. Your fleet gets a +10% fleet morale bonus.",
            "hidden": false
          }
        ]
      },
      {
        "name": "Former Frigate Captain",
        "id": "78e6-2e86-222e-fe6e",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "db03-09cd-f4d9-5b7e", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 9}],
        "rules": [
          {
            "name": "Former Frigate Captain",
            "id": "5b5e-e3b3-44c8-4cd6",
            "description": "Squadron tactics were key to the US naval strategy, something this admiral knows well. He trains his fleet to work as a single, cohesive whole. When your squadrons combine fire, use the closest squadron member when working out range.",
            "hidden": false
          }
        ]
      },
