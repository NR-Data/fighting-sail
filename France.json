      {
        "name": "Revolutionary",
        "id": "caf6-1f54-afba-798b",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "058c-934a-53f9-0745", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 6}],
        "rules": [
          {
            "name": "Revolutionary",
            "id": "15c1-0d3b-511d-91cc",
            "description": "When the French Revolution started in 1789, most of the French Navy's noble captains were arrested and replaced by brash, less experienced revolutionaries. Once per battle, at the start of the turn, you may add +3 to your initiative roll for the turn. You must decide to use this ability before rolling for the turn.",
            "hidden": false
          }
        ]
      },
      {
        "name": "Former Privateer",
        "id": "6a0c-395f-0e20-d4e4",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "7104-20d4-fd5e-12c6", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 11}],
        "rules": [
          {
            "name": "Former Privateer",
            "id": "8d15-aee7-5289-c1fc",
            "description": "French Privateers were the scourge of the European coastlines. This admiral spent his early years with a cutlass in one hand and a letter of marque in the other. Once per battle, when one of your ships collides with an enemy ship, the enemy ship may not make a Sailing test in order to avoid it.",
            "hidden": false
          }
        ]
      },
      {
        "name": "Hero",
        "id": "04e6-eb64-8c3f-e1ed",
        "collective": false,
        "hidden": false,
        "type": "upgrade",
        "categoryLinks": [{"name": "New CategoryLink", "id": "0248-e403-a7d9-5ea1", "hidden": false, "primary": true, "targetId": "ca3c-95e8-59ff-7cdc"}],
        "costs": [{"name": " Points", "typeId": "8798-8366-550b-fbb8", "value": 6}],
        "rules": [
          {
            "name": "Hero",
            "id": "43ca-192e-cb55-7302",
            "description": "Well known amongst captains and sailors alike, the Hero leads by example. His men often fear his disappointment more than they feaqr the cannons of their enemies. Your fleet gets a +10% fleet morale bonus.",
            "hidden": false
          }
        ]
      },
